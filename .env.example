# Never commit real credentials.
POSTGRES_PASSWORD=replace-for-local-development
DATABASE_URL=postgresql://paisa:replace-for-local-development@127.0.0.1:5432/paisa
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# PAISA_DATA_DIR=/absolute/path/to/paisa/data
PORT=4000
HOST=127.0.0.1

# Optional private analytics; all three required. Leave blank to disable.
# Public configuration, never an API token. Production builds on this exact hostname only.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_ANALYTICS_HOSTNAME=

# Public site root, including a GitHub Pages subpath; used in sharing metadata.
# NEXT_PUBLIC_SITE_URL=https://paisa-india.github.io/paisa/
